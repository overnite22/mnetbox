    "Native iPhone application. iOS 26 or later. French and English.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native iPhone application. iOS 26 or later. French and English."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Application native pour iPhone. iOS 26 ou ultérieur. Français et anglais."
          }
        }
      }
    },
    "The reference version is NetBox 4.7.2. Other versions require validation; this does not prevent browsing. Permissions and server constraints still apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reference version is NetBox 4.7.2. Other versions require validation; this does not prevent browsing. Permissions and server constraints still apply."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de référence est NetBox 4.7.2. Les autres versions restent à vérifier ; cela ne bloque pas la consultation. Les permissions et contraintes du serveur s’appliquent toujours."
          }
        }
      }
    },
    "Your server and token stay in this device’s Keychain. Requests go to the HTTPS NetBox server you choose.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server and token stay in this device’s Keychain. Requests go to the HTTPS NetBox server you choose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur et votre jeton sont conservés dans le Trousseau de cet appareil. Les requêtes sont envoyées au serveur NetBox HTTPS que vous choisissez."
          }
        }
      }
    },
    "MNetBox has no advertising, analytics or developer telemetry. NetBox may retain access logs and reviewed changes according to its own policy.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MNetBox has no advertising, analytics or developer telemetry. NetBox may retain access logs and reviewed changes according to its own policy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MNetBox n’intègre ni publicité, ni analyse d’usage, ni télémétrie du développeur. NetBox peut conserver des journaux d’accès et les modifications validées selon sa propre politique."
          }
        }
      }
    },
    "Browsing needs read permissions. Changes need a write-enabled token and corresponding NetBox permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browsing needs read permissions. Changes need a write-enabled token and corresponding NetBox permissions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La consultation nécessite les permissions de lecture. Les modifications nécessitent un jeton autorisé en écriture et les permissions NetBox correspondantes."
          }
        }
      }
    },
    "Changes are reviewed before confirmation. External synchronization can overwrite fields it manages.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes are reviewed before confirmation. External synchronization can overwrite fields it manages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont présentées avant confirmation. Une synchronisation externe peut réécrire les champs qu’elle gère."
          }
        }
      }
    },
    "This report contains only app, iOS and NetBox versions. It excludes tokens, server addresses, accounts and inventory.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This report contains only app, iOS and NetBox versions. It excludes tokens, server addresses, accounts and inventory."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce diagnostic contient uniquement les versions de l’app, d’iOS et de NetBox. Il exclut les jetons, adresses de serveurs, comptes et objets de l’inventaire."
          }
        }
      }
    },
    "Your token is stored in this device’s Keychain. Browsing needs read permissions; changes need a write-enabled token and corresponding NetBox permissions.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your token is stored in this device’s Keychain. Browsing needs read permissions; changes need a write-enabled token and corresponding NetBox permissions."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeton est conservé dans le Trousseau de cet appareil. La consultation nécessite les permissions de lecture ; les modifications nécessitent un jeton autorisé en écriture et les permissions NetBox correspondantes."
          }
        }
      }
    },
    "Enter your own HTTPS NetBox URL, then select your token format. NetBox v1 uses Token; v2 uses Bearer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your own HTTPS NetBox URL, then select your token format. NetBox v1 uses Token; v2 uses Bearer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez l’URL HTTPS de votre serveur NetBox, puis choisissez le format de votre jeton. NetBox v1 utilise Token ; v2 utilise Bearer."
          }
        }
      }
    },
    "Start with read permissions. Enable writes only for the objects you intend to change.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with read permissions. Enable writes only for the objects you intend to change."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez avec les permissions de lecture. Autorisez l’écriture uniquement sur les objets que vous comptez modifier."
          }
        }
      }
    },
    "Search inventory, IPAM, VLANs, VRFs, tenants, clusters and locations.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search inventory, IPAM, VLANs, VRFs, tenants, clusters and locations."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher dans l’inventaire, l’IPAM, les VLAN, VRF, tenants, clusters et emplacements."
          }
        }
      }
