        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action modifie uniquement le champ sélectionné sur le serveur. Une valeur vide efface la valeur existante."
          }
        }
      }
    },
    "Plain text and Markdown are supported. Only surrounding whitespace is removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain text and Markdown are supported. Only surrounding whitespace is removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte brut et Markdown sont acceptés. Seuls les espaces en début et fin sont supprimés."
          }
        }
      }
    },
    "DNS names are stored in lowercase. This updates NetBox only; it does not change your DNS server.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS names are stored in lowercase. This updates NetBox only; it does not change your DNS server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms DNS sont enregistrés en minuscules. Seul NetBox est modifié ; votre serveur DNS reste inchangé."
          }
        }
      }
    },
    "Reload before trying again. Your draft is kept. If the connection failed, check the current value: the change may already have been saved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload before trying again. Your draft is kept. If the connection failed, check the current value: the change may already have been saved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechargez avant de réessayer. Votre brouillon est conservé. Si la connexion a échoué, vérifiez la valeur actuelle : la modification peut déjà être enregistrée."
          }
        }
      }
    },
    "Enter a hostname or FQDN using letters, numbers, hyphens, underscores and dots. A wildcard is allowed only at the start.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a hostname or FQDN using letters, numbers, hyphens, underscores and dots. A wildcard is allowed only at the start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un nom DNS avec des lettres, chiffres, tirets, traits de soulignement et points. Un joker est autorisé uniquement au début."
          }
        }
      }
    },
