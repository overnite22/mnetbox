        }
      }
    },
    "NetBox rejected the creation. Check required fields and uniqueness rules in NetBox.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "NetBox rejected the creation. Check required fields and uniqueness rules in NetBox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NetBox a refusé la création. Vérifiez les champs obligatoires et les règles d’unicité dans NetBox."
          }
        }
      }
    },
    "This creates one object in NetBox. No interface assignment or DNS server change is made.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates one object in NetBox. No interface assignment or DNS server change is made."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action crée un objet dans NetBox, sans affectation à une interface ni modification du serveur DNS."
          }
        }
      }
    },
    "The duplicate check covers visible objects only. NetBox permissions and uniqueness rules still apply.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The duplicate check covers visible objects only. NetBox permissions and uniqueness rules still apply."
