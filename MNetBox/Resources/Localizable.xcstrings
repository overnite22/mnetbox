          }
        }
      }
    },
    "A prefix must use its network address. For example, use 192.0.2.0/24 rather than 192.0.2.10/24.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A prefix must use its network address. For example, use 192.0.2.0/24 rather than 192.0.2.10/24."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un préfixe doit utiliser son adresse réseau. Par exemple, saisissez 192.0.2.0/24 au lieu de 192.0.2.10/24."
          }
        }
      }
    },
    "This prefix or IP address already exists in the selected VRF. Review the existing object before creating another.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This prefix or IP address already exists in the selected VRF. Review the existing object before creating another."
