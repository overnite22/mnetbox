    },
    "Creation was attempted. Check existing objects before starting again; the response may have been lost.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation was attempted. Check existing objects before starting again; the response may have been lost."
          }
        },
        "fr": {
