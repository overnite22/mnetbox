        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification des doublons porte uniquement sur les objets visibles. Les permissions et règles d’unicité de NetBox restent applicables."
          }
        }
      }
    },
    "Include the prefix length (/24, /64, etc.). Prefixes must use the network address.": {
      "localizations": {
